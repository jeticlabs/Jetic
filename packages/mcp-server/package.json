{
  "name": "@jetic/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) Server for Jetic Behavioral Models",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "jetic-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "jetic",
    "mcp",
    "model-context-protocol",
    "ai",
    "api-testing",
    "opencode",
    "cursor",
    "claude"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@faker-js/faker": "^9.0.0",
    "@jetic/core": "workspace:*",
    "@jetic/memory": "workspace:*",
    "@jetic/model": "workspace:*",
    "@jetic/scanner": "workspace:*",
    "@jetic/simulator": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5"
  }
}
