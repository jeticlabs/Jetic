{
  "name": "jetic-cli",
  "version": "0.2.4",
  "description": "Code-aware, deterministic API toolkit for Node.js",
  "main": "dist/index.js",
  "bin": {
    "jetic": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node -e \"try { const fs = require('fs'); fs.rmSync('./dist/dashboard', { recursive: true, force: true }); fs.cpSync('../dashboard/dist', './dist/dashboard', { recursive: true }); console.log('Bundled dashboard into dist/dashboard'); } catch (e) { console.warn('Could not bundle dashboard dist (build @jetic/dashboard first):', e.message); }\"",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "keywords": [
    "jetic",
    "api-testing",
    "api-discovery",
    "ast-parser",
    "behavior-testing",
    "workflow-simulation",
    "express",
    "nodejs",
    "typescript",
    "testing-framework",
    "api-inspector",
    "ai-testing"
  ],
  "author": "Jetic Labs",
  "license": "ISC",
  "homepage": "https://jetic.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeticlabs/jetic.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/jeticlabs/jetic/issues"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "commander": "^12.0.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@jetic/agent-sdk": "workspace:*",
    "@jetic/agents": "workspace:*",
    "@jetic/adapter-express": "workspace:*",
    "@jetic/adapter-fastify": "workspace:*",
    "@jetic/adapter-hono": "workspace:*",
    "@jetic/adapter-nestjs": "workspace:*",
    "@jetic/adapter-nextjs": "workspace:*",
    "@jetic/core": "workspace:*",
    "@jetic/dashboard": "workspace:*",
    "@jetic/mcp-server": "workspace:*",
    "@jetic/memory": "workspace:*",
    "@jetic/model": "workspace:*",
    "@jetic/scanner": "workspace:*",
    "@jetic/scanner-sdk": "workspace:*",
    "@jetic/sdk": "workspace:*",
    "@jetic/simulator": "workspace:*",
    "tsup": "^8.5.1"
  }
}